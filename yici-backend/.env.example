# 模型后端：mock（默认，无需任何密钥即可联调）| openai（OpenAI 兼容接口）
# MODEL_BACKEND=mock
MODEL_BACKEND=mock

# openai 后端必填三项（DashScope 示例见 README）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
MODEL_NAME=qwen-plus

# 模型调用超时（秒）
MODEL_TIMEOUT_SECONDS=30

# 请求体上限（字节）
MAX_BODY_BYTES=65536

# 公开接口限流：每 IP 每分钟 analyze 次数（0 表示不限）
RATE_LIMIT_PER_MINUTE=10

# 允许跨域的前端来源，逗号分隔；本地联调可用 *
CORS_ORIGINS=*

# 部署在反向代理后时设为 true，按 X-Forwarded-For 限流
TRUST_PROXY=false